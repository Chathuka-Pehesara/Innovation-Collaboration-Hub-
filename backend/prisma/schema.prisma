// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  projects Project[]
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  projects ProjectTag[]
}

model Skill {
  id       String         @id @default(uuid())
  name     String         @unique
  projects ProjectSkill[]
  users    UserSkill[]
  assessments SkillAssessment[]
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Project {
  id          String         @id @default(uuid())
  title       String
  description String
  status      ProjectStatus  @default(DRAFT)
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id])
  ownerId     String
  owner       User           @relation("UserProjects", fields: [ownerId], references: [id], onDelete: Cascade)
  teamSize    Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  tags        ProjectTag[]
  skills      ProjectSkill[]
  aiResult    AIResult?
  team        Team?
  commits     Commit[]
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model ProjectSkill {
  projectId String
  skillId   String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
}

model AIResult {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  score       Int
  suggestions String   // Can store JSON array of strings
}

model Commit {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message     String
  filesChanged Int     @default(1)
  additions   Int      @default(0)
  deletions   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([userId])
}

model Team {
  id          String         @id @default(uuid())
  projectId   String         @unique
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  members     TeamMember[]
  invites     TeamInvite[]
  tasks       Task[]
  resources   Resource[]
  activities  Activity[]
  chat        Chat?
}

enum TeamRole {
  LEAD
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum TeamInviteType {
  INVITE
  APPLICATION
}

model TeamMember {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String   
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        TeamRole @default(MEMBER)
  joinedAt    DateTime @default(now())

  @@unique([teamId, userId])
}

model TeamInvite {
  id          String           @id @default(uuid())
  teamId      String
  team        Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      String   
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      TeamInviteStatus @default(PENDING)
  type        TeamInviteType   @default(INVITE)
  createdAt   DateTime         @default(now())

  @@unique([teamId, userId])
}

model Task {
  id          String     @id @default(uuid())
  teamId      String
  team        Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  assigneeId  String?    // User ID
  assignee    User?      @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Resource {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  uploadedBy  String   // User ID
  uploader    User     @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Activity {
  id          String   @id @default(uuid())
  teamId      String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  action      String
  userId      String   // User who performed the action
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Chat {
  id           String            @id @default(uuid())
  name         String?
  isGroup      Boolean           @default(false)
  teamId       String?           @unique
  team         Team?             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  messages     Message[]
  participants ChatParticipant[]
}

model ChatParticipant {
  id       String   @id @default(uuid())
  chatId   String
  chat     Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([chatId, userId])
}

model Message {
  id        String           @id @default(uuid())
  chatId    String
  chat      Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String?
  fileUrl   String?
  fileName  String?
  fileType  String?
  createdAt DateTime         @default(now())
  receipts  MessageReceipt[]
}

model MessageReceipt {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
}

enum NotificationType {
  TEAM_MESSAGE
  DM_MESSAGE
  SYSTEM
  TEAM_INVITE
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  message     String
  referenceId String?          // ID of the Chat/Team related to the notification
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

// ─── Profile Management Models ──────────────────────────────────────────────

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum BadgeTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  username             String            @unique
  name                 String
  role                 Role              @default(STUDENT)
  password             String            // encrypted
  bio                  String?           @db.Text
  specialization       String?           // AI, IT, Cybersecurity, Networking, Other
  avatarUrl            String?
  githubUrl            String?
  githubUsername       String?
  githubPrCount        Int               @default(0)
  githubTitle          String?
  linkedinUrl          String?
  portfolioUrl         String?
  twitterUrl           String?
  availableHours       Int               @default(0) // weekly hours available
  availableDays        String            @default("[]") // JSON array of day names
  xp                   Int               @default(0)
  level                Int               @default(1)
  isVerified           Boolean           @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  skills               UserSkill[]
  skillAssessments     SkillAssessment[]
  portfolioItems       PortfolioItem[]
  refreshTokens        RefreshToken[]
  badges               UserBadge[]
  projects             Project[]         @relation("UserProjects")
  commits              Commit[]
  teamMembers          TeamMember[]
  teamInvites          TeamInvite[]
  assignedTasks        Task[]
  uploadedResources    Resource[]
  activities           Activity[]
  chatParticipants     ChatParticipant[]
  messages             Message[]
  messageReceipts      MessageReceipt[]
  notifications        Notification[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model UserSkill {
  id        String     @id @default(uuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     SkillLevel @default(BEGINNER)
  score     Int        @default(0)
  addedAt   DateTime   @default(now())

  @@unique([userId, skillId])
}

model PortfolioItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  description String? @db.Text
  url       String?
  imageUrl  String?
  tags      String   @default("[]") // JSON array of tag strings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SkillAssessment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  score     Int      
  passed    Boolean
  createdAt DateTime @default(now())
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique // e.g., "React Novice", "Java Expert"
  description String?
  icon        String?     // e.g. a lucide icon name or emoji
  tier        BadgeTier   @default(BRONZE)
  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ─── Security Models ──────────────────────────────────────────────

enum ThreatType {
  HONEYPOT
  BRUTE_FORCE
  INVALID_POW
  RATE_LIMIT_EXCEEDED
  MALFORMED_REQUEST
  INVALID_INPUT
  SESSION_CREATED
  SESSION_REVOKED
  SESSION_EXPIRED
  SUSPICIOUS_SESSION
  SQL_INJECTION_ATTEMPT
}

enum ThreatSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ThreatLog {
  id          String         @id @default(uuid())
  ip          String?
  type        ThreatType
  severity    ThreatSeverity
  fingerprint String?
  metadata    String?        @db.Text // JSON string for extra data
  createdAt   DateTime       @default(now())
}
